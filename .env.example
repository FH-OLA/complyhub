# ─── Supabase ───────────────────────────────────────────────────────────────────
# Project URL and anon key are public and baked into the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key has full database access — server-only, never expose to browsers.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Stripe ─────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
STRIPE_PRICE_ID=price_your-pro-plan-price-id

# ─── AI (Anthropic) ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Model used for AI Advisor responses. Defaults to claude-haiku-4-5-20251001.
AI_MODEL=claude-haiku-4-5-20251001

# Maximum AI Advisor questions per Pro user per calendar month (UTC).
AI_MONTHLY_LIMIT_PRO=100

# Maximum AI Advisor questions per user in any rolling 60-second window.
AI_BURST_LIMIT_PER_MINUTE=5

# ─── Companies House ────────────────────────────────────────────────────────────
# API key for the Companies House REST API (Basic auth, key as username, no password).
COMPANIES_HOUSE_API_KEY=your-companies-house-api-key

# ─── Email (Resend) ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your-resend-api-key

# Verified sender address for compliance alert emails.
# The domain must be verified in your Resend account.
ALERT_FROM_EMAIL=alerts@yourdomain.com

# HMAC-SHA256 secret for generating and verifying unsubscribe tokens.
# Rotating this value invalidates all outstanding unsubscribe links.
UNSUBSCRIBE_SECRET=your-long-random-unsubscribe-secret

# ─── Application URLs ───────────────────────────────────────────────────────────
# Public base URL used for Stripe return_url and other absolute client-side links.
NEXT_PUBLIC_BASE_URL=https://yourdomain.com

# Canonical server-side URL used for email links and unsubscribe URLs.
# Typically the same value as NEXT_PUBLIC_BASE_URL.
APP_URL=https://yourdomain.com

# ─── Alerts cron ────────────────────────────────────────────────────────────────
# Bearer token expected by GET /api/alerts/run.
# Set this as the Authorization header value in your Vercel cron configuration:
#   Authorization: Bearer <CRON_SECRET>
CRON_SECRET=your-long-random-cron-secret

# ─── Admin dashboard ────────────────────────────────────────────────────────────
# Comma-separated list of email addresses permitted to access /admin.
# Non-listed authenticated users receive a 404 (route existence is not revealed).
ADMIN_EMAILS=founder@yourdomain.com
